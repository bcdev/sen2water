<operator>
  <name>Sen2Water-${project.version}</name>
  <operatorClass>org.esa.snap.core.gpf.operators.tooladapter.ToolAdapterOp</operatorClass>
  <!-- This alias must be identical with the one from manifest.mf: OpenIDE-Module-Alias -->
  <alias>Sen2Water-${project.version}</alias>
  <label>Sen2Water Atmospheric Correction over ocean and inland water</label>
  <version>${project.version}</version>
  <description>${project.description}</description>
  <authors>Brockmann Consult GmbH, developed for ESA OPT-MPC</authors>
  <copyright>Brockmann Consult GmbH (C2RCC, Idepix, msiresampling, sen2water wrapper), Hygeos (POLYMER), RBINS
    (ACOLITE)
  </copyright>
  <helpID>s2w_overview</helpID>
  <internal>false</internal>
  <autoWriteSuppressed>false</autoWriteSuppressed>
  <menuLocation>Menu/Optical/Thematic Water Processing</menuLocation>
  <preprocessTool>false</preprocessTool>
  <writeForProcessing>false</writeForProcessing>
  <mainToolFileLocation>$S2WDIR/bin/$S2WSCRIPT</mainToolFileLocation>
  <workingDir>$USERPROFILE</workingDir>
  <template type="file">
    <file>Sen2Water-template.vm</file>
  </template>
  <progressPattern>Progress\[%\]: (\d{1,3})\.(?:.+)</progressPattern>
  <variables>
    <osvariable>
      <key>USERPROFILE</key>
      <isShared>false</isShared>
      <windows/>
      <linux>$HOME</linux>
      <isTransient>false</isTransient>
    </osvariable>
    <osvariable>
      <key>HOME</key>
      <isShared>false</isShared>
      <windows>$USERPROFILE</windows>
      <linux/>
      <isTransient>false</isTransient>
    </osvariable>
    <osvariable>
      <key>S2WDIR</key>
      <isShared>false</isShared>
      <windows>$USERPROFILE\.snap\auxdata\sen2water-${project.version}-win64</windows>
      <linux>$USERPROFILE/.snap/auxdata/sen2water-${project.version}-linux</linux>
      <isTransient>false</isTransient>
    </osvariable>
    <osvariable>
      <key>S2WSCRIPT</key>
      <isShared>false</isShared>
      <windows>sen2water.bat</windows>
      <linux>sen2water.sh</linux>
      <isTransient>false</isTransient>
    </osvariable>
  </variables>
  <parameters>
    <parameter>
      <name>outputdir</name>
      <dataType>java.io.File</dataType>
      <defaultValue/>
      <description>Output directory (If not specified, the input product location is used)</description>
      <label>Output Directory</label>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>FolderParameter</parameterType>
    </parameter>
    <parameter>
      <name>withoutcleanup</name>
      <dataType>java.lang.Boolean</dataType>
      <description>Optionally preserves intermediate files</description>
      <label>Without Cleanup</label>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>withdetfoofilter</name>
      <dataType>java.lang.Boolean</dataType>
      <description>Optionally sets pixels with mixed detector contributions to invalid</description>
      <label>With Detector Filtering</label>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>withouttgc</name>
      <dataType>java.lang.Boolean</dataType>
      <description>Optionally switches off TOA Glint Correction</description>
      <label>Without TOA Glint Correction</label>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>dem</name>
      <dataType>java.lang.String</dataType>
      <defaultValue>Copernicus 90m Global DEM</defaultValue>
      <description>Name of DEM collection, Copernicus 90m Global DEM or Copernicus 30m Global DEM</description>
      <label>DEM</label>
      <valueSet>
        <string>Copernicus 90m Global DEM</string>
        <string>Copernicus 30m Global DEM</string>
      </valueSet>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>acoliteanc</name>
      <dataType>java.lang.String</dataType>
      <defaultValue>embedded</defaultValue>
      <description>Name of ancillary data for ACOLITE, embedded or constant</description>
      <label>ACOLITE Ancillary Data</label>
      <valueSet>
        <string>embedded</string>
        <string>constant</string>
      </valueSet>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>c2rccanc</name>
      <dataType>java.lang.String</dataType>
      <defaultValue>constant</defaultValue>
      <description>Name of ancillary data for C2RCC, constant or embedded</description>
      <label>C2RCC Ancillary Data</label>
      <valueSet>
        <string>embedded</string>
        <string>constant</string>
      </valueSet>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>polymeranc</name>
      <dataType>java.lang.String</dataType>
      <defaultValue>embedded</defaultValue>
      <description>Name of ancillary data for POLYMER, embedded or nasa</description>
      <label>Polymer Ancillary Data</label>
      <valueSet>
        <string>embedded</string>
        <string>nasa</string>
        <string>constant</string>
      </valueSet>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
    <parameter>
      <name>targetProductFile</name>
      <dataType>java.io.File</dataType>
      <defaultValue/>
      <description>Output file</description>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <parameterType>RegularParameter</parameterType>
    </parameter>
  </parameters>
  <source>user</source>
  <isSystem>false</isSystem>
  <isHandlingOutputName>true</isHandlingOutputName>
  <windowsBundle>
    <bundleType>ZIP</bundleType>
    <bundleLocation>REMOTE</bundleLocation>
    <downloadURL>https://www.brockmann-consult.de/Sen2Water.tmp/sen2water-${project.version}-win64.zip
    </downloadURL>
    <templateparameter>
      <template type="simple">
        <contents/>
      </template>
      <outputFile>Command Template</outputFile>
    </templateparameter>
    <targetLocation>$USERPROFILE/.snap/auxdata/sen2water-${project.version}-win64</targetLocation>
    <entryPoint>sen2water-${project.version}-win64.zip</entryPoint>
    <updateVariable>S2WDIR</updateVariable>
  </windowsBundle>
  <linuxBundle>
    <bundleType>INSTALLER</bundleType>
    <bundleLocation>REMOTE</bundleLocation>
    <downloadURL>https://www.brockmann-consult.de/Sen2Water.tmp/sen2water-${project.version}-linux.run</downloadURL>
    <templateparameter>
      <name>arguments</name>
      <dataType>java.io.File</dataType>
      <defaultValue>Command Template</defaultValue>
      <notNull>false</notNull>
      <notEmpty>false</notEmpty>
      <deprecated>false</deprecated>
      <parameterType>TemplateParameter</parameterType>
      <parameters>
        <parameter>
          <name>targetLocation</name>
          <dataType>java.io.File</dataType>
          <defaultValue>$USERPROFILE/.snap/auxdata</defaultValue>
          <notNull>false</notNull>
          <notEmpty>false</notEmpty>
          <parameterType>RegularParameter</parameterType>
        </parameter>
      </parameters>
      <template type="simple">
        <contents>--nox11 --target $targetLocation/sen2water-${project.version}-linux</contents>
      </template>
      <outputFile>Command Template</outputFile>
    </templateparameter>
    <targetLocation>$USERPROFILE/.snap/auxdata</targetLocation>
    <entryPoint>sen2water-${project.version}-linux.run</entryPoint>
    <updateVariable>S2WDIR</updateVariable>
  </linuxBundle>
  <macosxBundle>
    <bundleType>NONE</bundleType>
    <bundleLocation>REMOTE</bundleLocation>
    <updateVariable>S2WDIR</updateVariable>
  </macosxBundle>
  <sourceProductDescriptors>
    <org.esa.snap.core.gpf.descriptor.SimpleSourceProductDescriptor>
      <name>sourceProduct</name>
    </org.esa.snap.core.gpf.descriptor.SimpleSourceProductDescriptor>
  </sourceProductDescriptors>
  <targetPropertyDescriptors/>
  <numSourceProducts>1</numSourceProducts>
  <templateType>VELOCITY</templateType>
</operator>